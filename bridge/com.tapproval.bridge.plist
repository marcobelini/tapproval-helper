<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bridge's login item (1.1.0), sealed in the signed app at
     Contents/Library/LaunchAgents and registered by the bridge itself
     (main.swift, - -register), so Login Items lists it as "Tapproval".
     AbandonProcessGroup: the relay the bridge wakes must outlive a bridge
     restart, an update included. Its label is its own (1.1.1): under the
     old job file's label macOS registered it and could not start it,
     "spawn failed", wherever it still remembered the old job. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tapproval.bridge.login</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Tapproval</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/Tapproval</string>
		<string>--agent</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>AbandonProcessGroup</key>
	<true/>
</dict>
</plist>
